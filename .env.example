# Server-side API credentials. Set either TMDB_API_KEY (v3) or
# TMDB_ACCESS_TOKEN (v4 Read Access Token), not necessarily both.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
MANGADEX_ACCESS_TOKEN=
# Authorized playback API adapter (optional; keeps the bearer token server-side).
MILKBOX_PLAYBACK_API_URL=
MILKBOX_PLAYBACK_API_KEY=
PORT=3000